# Copy to .env and edit. Every setting is optional except DOMAIN + APP_PASSWORD when deploying publicly.
DOMAIN=a11y.example.com            # public host name (docker-compose + Caddy get a free HTTPS certificate for it)
APP_PASSWORD=change-me-long-random # REQUIRED for a public server: browser asks for it (any username)
MAX_UPLOAD_MB=200                 # also raise MAX_BODY below (and nginx client_max_body_size) if you change this
MAX_PAGES=1000
RETENTION_MINUTES=60               # uploaded + repaired files are deleted after this long
MAX_JOBS=2                         # repairs running at the same time (each uses a CPU core + ~250 MB)
RATE_LIMIT_PER_MIN=20              # uploads/repairs per client IP per minute (0 = off)
TRUST_PROXY=1                      # 1 only when behind Caddy/nginx you control (reads the real client IP)
ANTHROPIC_API_KEY=                 # optional: AI-written alt text (always marked "needs review")
ALT_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=                      # optional: Groq vision API key for AI-written alt text (takes precedence if set)
GROQ_ALT_MODEL=qwen/qwen3.8-27b
VERAPDF=                           # optional: path to the veraPDF CLI inside the container/host
OCR_LANGS=eng                      # docker build only: tesseract languages to install, e.g. "eng deu fra"
MAX_BODY=210MB                     # Caddy request limit: keep it a little above MAX_UPLOAD_MB
DATA_TMPFS=4g                      # RAM-backed storage for uploads; ~4x the largest upload per file in progress
MEM_LIMIT=6g                       # container memory; must exceed DATA_TMPFS
